# --------------------------------------------------------------------------- #
# rag-showcase — environment template (12-factor)
# Copy to `.env` and fill in. `.env` is git-ignored and never committed.
#   cp .env.example .env
# --------------------------------------------------------------------------- #

# ---------------------------- Qdrant vector store -------------------------- #
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_showcase
# Only needed for Qdrant Cloud / secured deployments.
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10.0

# ----------------------------------- LLM ----------------------------------- #
# Which backend generates answers. Both speak the OpenAI chat protocol, so the
# service code is identical — only the endpoint, key and model id change.
#   ollama -> fully local, no key, no data leaves the machine (default)
#   openai -> hosted API, or any OpenAI-compatible gateway
LLM_PROVIDER=ollama

# -- LLM_PROVIDER=ollama --------------------------------------------------- #
# Start the daemon and pull the model first:  ollama run llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# -- LLM_PROVIDER=openai --------------------------------------------------- #
# Required only when LLM_PROVIDER=openai (startup fails fast if it is missing).
# Ragas evaluation always needs it, regardless of the provider: the judge model
# and the relevance embeddings are OpenAI-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible gateway (Azure, vLLM, LiteLLM, OpenRouter).
# Keep this COMMENTED OUT unless you use it. direnv exports every key in the file,
# and the OpenAI SDK reads OPENAI_BASE_URL from the environment itself: an exported
# empty string points the client at "" rather than at the default host.
#OPENAI_BASE_URL=

# -- shared generation parameters ------------------------------------------ #
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=800

# ------------------------------- ML models --------------------------------- #
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MAX_LENGTH=512
# cpu | mps | cuda — leave empty for auto-detection.
MODEL_DEVICE=

# ------------------------------- Retrieval --------------------------------- #
# Stage 1: dense candidates pulled from Qdrant.
RETRIEVAL_CANDIDATES=10
# Stage 2: documents kept after cross-encoder reranking.
RERANK_TOP_N=3
# Hard ceiling for the `k` request field.
MAX_TOP_K=10
SCORE_THRESHOLD=

# ------------------------------- Chunking ---------------------------------- #
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DOCUMENTS_DIR=documents
INGEST_UPSERT_BATCH_SIZE=128

# ------------------------------- Timeouts ---------------------------------- #
RETRIEVAL_TIMEOUT_SECONDS=15.0
# Local models are slower than hosted ones, and the first call also pays for
# loading weights into memory — allow more headroom when LLM_PROVIDER=ollama.
GENERATION_TIMEOUT_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=90.0

# ----------------------------- Langfuse (LLMOps) --------------------------- #
# Tracing is auto-disabled when the keys are absent — the service still runs.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------- Service ----------------------------------- #
APP_NAME=rag-showcase
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
